{
  "name": "GameScript",
  "scopeName": "source.gamescript",
  "patterns": [
    { "include": "#comment" },
    { "include": "#type-declaration" },
    { "include": "#table-declaration" },
    { "include": "#method-declaration" },
    { "include": "#member-access" },
    { "include": "#method-call" },
    { "include": "#variable-declaration" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#boolean-literals" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#variables" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.gamescript",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.gamescript" } },
          "end": "$\\n?"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gamescript",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.gamescript" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.gamescript" } },
          "patterns": [
            { "name": "constant.character.escape.gamescript", "match": "\\{\\{|\\}\\}" },
            {
              "name": "meta.interpolation.gamescript",
              "begin": "\\{",
              "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.gamescript" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.gamescript" } },
              "patterns": [
                { "include": "#member-access" },
                { "include": "#method-call" },
                { "include": "#keywords" },
                { "include": "#boolean-literals" },
                { "include": "#numbers" },
                { "include": "#variables" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [ { "name": "constant.numeric.gamescript", "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?)\\b" } ]
    },
    "boolean-literals": {
      "patterns": [ { "name": "constant.language.boolean.gamescript", "match": "\\b(?:true|false)\\b" } ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.gamescript", "match": "\\b(?:if|else|return|while|switch|case|default|for|in|break|continue|and|or|not)\\b" },
        { "name": "keyword.declaration.gamescript", "match": "\\b(?:func|command|trigger|table)\\b" },
        { "name": "invalid.deprecated.gamescript", "match": "\\blabel\\b" }
      ]
    },
    "types": {
      "patterns": [ { "name": "storage.type.gamescript", "match": "\\b(?:int|bool|string|func)\\b" } ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.other.context.gamescript",  "match": "@[A-Za-z_][\\w]*" },
        { "name": "variable.other.constant.gamescript", "match": "\\^[A-Za-z_][\\w]*" }
      ]
    },
    "method-declaration": {
      "patterns": [
        {
          "name": "meta.function.declaration.gamescript",
          "begin": "^(\\s*)(?:(func|command|trigger)|([A-Za-z_][\\w]*))\\s+([A-Za-z_][\\w]*(?::[A-Za-z_][\\w]*)?)\\s*(?=\\(|$)",
          "beginCaptures": {
            "1": { "name": "punctuation.whitespace.leading.gamescript" },
            "2": { "name": "keyword.declaration.gamescript" },
            "3": { "name": "keyword.declaration.trigger.gamescript" },
            "4": { "name": "entity.name.function.gamescript" }
          },
          "end": "$",
          "patterns": [
            { "name": "keyword.declaration.returns.gamescript", "match": "\\breturns\\b" },
            {
              "comment": "command '= engine_op' binding — the trailing '= name' after the signature",
              "match": "(=)\\s*([A-Za-z_][\\w]*)\\s*(?=$|//|/\\*)",
              "captures": {
                "1": { "name": "keyword.operator.binding.gamescript" },
                "2": { "name": "entity.name.tag.op-binding.gamescript" }
              }
            },
            {
              "comment": "'TYPE name' parameter pairs — any type name, named types included",
              "match": "\\b(?!returns\\b)([A-Za-z_][\\w]*)\\s+([A-Za-z_][\\w]*)\\b(?=\\s*(?:,|\\)|=))",
              "captures": {
                "1": { "name": "storage.type.gamescript" },
                "2": { "name": "variable.parameter.gamescript" }
              }
            },
            {
              "comment": "single return type after 'returns' (tuple element types are colored by semantic tokens)",
              "match": "(?<=\\breturns\\s)([A-Za-z_][\\w]*)\\b",
              "captures": { "1": { "name": "storage.type.gamescript" } }
            },
            { "include": "#variables" },
            { "include": "#types" },
            { "include": "#strings" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "type-declaration": {
      "patterns": [
        {
          "comment": "type NAME : int|string — 'type' is contextual: only a top-level 'type NAME :' line declares a named type",
          "name": "meta.type.declaration.gamescript",
          "match": "^(type)\\s+([A-Za-z_][\\w]*)\\s*(:)\\s*([A-Za-z_][\\w]*)?",
          "captures": {
            "1": { "name": "keyword.declaration.gamescript" },
            "2": { "name": "entity.name.type.gamescript" },
            "3": { "name": "punctuation.separator.type.gamescript" },
            "4": { "name": "storage.type.gamescript" }
          }
        }
      ]
    },
    "table-declaration": {
      "patterns": [
        {
          "comment": "table NAME([key] TYPE col, ...) — 'key' is a contextual column modifier; TYPE may be a named type",
          "name": "meta.table.declaration.gamescript",
          "begin": "^(\\s*)(table)\\s+([A-Za-z_][\\w]*)\\s*(?=\\(|$)",
          "beginCaptures": {
            "1": { "name": "punctuation.whitespace.leading.gamescript" },
            "2": { "name": "keyword.declaration.gamescript" },
            "3": { "name": "entity.name.type.table.gamescript" }
          },
          "end": "$",
          "patterns": [
            { "name": "storage.modifier.key.gamescript", "match": "\\bkey\\b(?=\\s+[A-Za-z_][\\w]*\\s+[A-Za-z_][\\w]*)" },
            {
              "comment": "'TYPE column' pairs — any type name, named types included",
              "match": "\\b(?!key\\b)([A-Za-z_][\\w]*)\\s+([A-Za-z_][\\w]*)\\b(?=\\s*(?:,|\\)))",
              "captures": {
                "1": { "name": "storage.type.gamescript" },
                "2": { "name": "variable.other.member.gamescript" }
              }
            },
            { "include": "#types" },
            { "include": "#variables" }
          ]
        }
      ]
    },
    "variable-declaration": {
      "patterns": [
        {
          "comment": "'TYPE name', 'TYPE ^const' or 'TYPE @context' — TYPE is any identifier (named types included), so statement keywords are excluded explicitly",
          "name": "meta.variable.declaration.gamescript",
          "match": "^(\\s*)(?!(?:if|else|return|while|switch|case|default|for|in|break|continue|and|or|not|command|trigger|table|type)\\b)([A-Za-z_][\\w]*)\\s+((?:@|\\^)?[A-Za-z_][\\w]*)\\b(?=\\s*(?:=|,|$))",
          "captures": {
            "2": { "name": "storage.type.gamescript" },
            "3": { "name": "variable.other.declared.gamescript" }
          }
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "comment": "table built-ins after a glued dot: t.count / t.has(...) / t.at(...)",
          "match": "(?<=[\\w\\)\\]])(\\.)(count|has|at)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.gamescript" },
            "2": { "name": "support.function.table.gamescript" }
          }
        },
        {
          "comment": "table column after a glued dot: t[k].col / t.at(i).col / r.col",
          "match": "(?<=[\\w\\)\\]])(\\.)([A-Za-z_][\\w]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.gamescript" },
            "2": { "name": "variable.other.member.gamescript" }
          }
        }
      ]
    },
    "method-call": {
      "patterns": [
        {
          "comment": "a cast 'item(x)' is lexically a call; the language server's semantic tokens recolor the callee as a type",
          "name": "support.function.call.gamescript",
          "match": "\\.?[A-Za-z_][\\w]*(?::[A-Za-z_][\\w]*)?\\s*(?=\\()"
        }
      ]
    }
  },
  "uuid": "d0e7cd4a-7e89-4e22-bbd6-1dc417552f3a"
}
